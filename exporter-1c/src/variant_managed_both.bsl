////////////////////////////////////////////////////////////////////////////////
// ВЫГРУЗКА СТРУКТУРЫ КОНФИГУРАЦИИ — УПРАВЛЯЕМАЯ ФОРМА, XML И JSON НА ВЫБОР
//
// Требует платформу 8.3.6 и выше (в модуле есть обращения к ЗаписьJSON).
// Для 8.3.5 используйте вариант УправляемаяФорма_XML.
//
// Собран автоматически из src/core.bsl + src/variant_managed_both.bsl.
// Правки вносить в src/, затем: python3 exporter-1c/build_modules.py
//
// Реквизиты формы, которые нужно создать:
//   ФорматВыгрузки Строка(10) — "xml" или "json", элемент формы = поле выбора
//   РазмерЧанка    Число      — объектов на файл (по умолчанию 500), 0 = без разбиения
//   ЛимитОбъектов  Число      — объектов каждого вида (по умолчанию 0), 0 = все
//
// Команда формы: ВыгрузитьСтруктуру
// Событие формы: ПриСозданииНаСервере
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(ФорматВыгрузки) Тогда
		ФорматВыгрузки = "json";
	КонецЕсли;
	Если РазмерЧанка = 0 Тогда
		РазмерЧанка = 500;
	КонецЕсли;

	СписокФорматов = Элементы.ФорматВыгрузки.СписокВыбора;
	СписокФорматов.Очистить();
	СписокФорматов.Добавить("json", "JSON");
	СписокФорматов.Добавить("xml", "XML");

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьСтруктуру(Команда)

	Результат = ПодготовитьВыгрузкуНаСервере();

	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		Возврат;
	КонецЕсли;

	ДиалогСохранения = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогСохранения.Заголовок = "Сохранить выгрузку структуры конфигурации";
	ДиалогСохранения.ПолноеИмяФайла = Результат.ИмяФайла;
	ДиалогСохранения.Фильтр = "ZIP-архив (*.zip)|*.zip";

	Если ДиалогСохранения.Выбрать() Тогда
		Попытка
			ДвоичныеДанныеАрхива = ПолучитьИзВременногоХранилища(Результат.Адрес);
			ДвоичныеДанныеАрхива.Записать(ДиалогСохранения.ПолноеИмяФайла);

			Сообщение = "Выгружено объектов: " + Результат.ВсегоОбъектов
				+ ", файлов: " + Результат.Файлов + Символы.ПС
				+ "Архив: " + ДиалогСохранения.ПолноеИмяФайла;

			Если Результат.Усечено Тогда
				Сообщение = Сообщение + Символы.ПС + Символы.ПС
					+ "ВНИМАНИЕ: выгрузка НЕПОЛНАЯ — задан лимит объектов."
					+ Символы.ПС + "Для рабочей загрузки установите ЛимитОбъектов = 0.";
			КонецЕсли;

			ПоказатьПредупреждение(, Сообщение);
		Исключение
			ПоказатьПредупреждение(, "Ошибка сохранения архива: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	УдалитьИзВременногоХранилища(Результат.Адрес);

КонецПроцедуры

&НаСервере
Функция ПодготовитьВыгрузкуНаСервере()

	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Адрес", "");
	Результат.Вставить("ИмяФайла", "");
	Результат.Вставить("ВсегоОбъектов", 0);
	Результат.Вставить("Файлов", 0);
	Результат.Вставить("Усечено", Ложь);

	ВыбранныйФормат = НРег(СокрЛП(ФорматВыгрузки));
	Если ВыбранныйФормат <> "xml" И ВыбранныйФормат <> "json" Тогда
		Результат.Ошибка = "Не выбран формат выгрузки (xml или json).";
		Возврат Результат;
	КонецЕсли;

	Если РазмерЧанка < 0 Тогда
		Результат.Ошибка = "Размер чанка не может быть отрицательным.";
		Возврат Результат;
	КонецЕсли;

	КаталогВыгрузки = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(КаталогВыгрузки);
	ВременныйАрхив = "";

	Попытка
		Итог = ВыгрузитьСтруктуруКонфигурации(
			КаталогВыгрузки, ВыбранныйФормат, РазмерЧанка, ЛимитОбъектов);
		ВременныйАрхив = УпаковатьВыгрузкуВАрхив(КаталогВыгрузки);

		ДвоичныеДанныеАрхива = Новый ДвоичныеДанные(ВременныйАрхив);
		Результат.Адрес = ПоместитьВоВременноеХранилище(
			ДвоичныеДанныеАрхива, Новый УникальныйИдентификатор());
		Результат.ИмяФайла = ИмяФайлаАрхива();
		Результат.ВсегоОбъектов = Итог.ВсегоОбъектов;
		Результат.Файлов = Итог.Файлов;
		Результат.Усечено = Итог.Усечено;
	Исключение
		Результат.Ошибка = "Ошибка выгрузки: " + ОписаниеОшибки();
	КонецПопытки;

	УдалитьФайлы(КаталогВыгрузки);
	Если ЗначениеЗаполнено(ВременныйАрхив) Тогда
		Попытка
			УдалитьФайлы(ВременныйАрхив);
		Исключение
		КонецПопытки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// {{CORE}}
