////////////////////////////////////////////////////////////////////////////////
// ВЫГРУЗКА СТРУКТУРЫ КОНФИГУРАЦИИ — ОБЫЧНАЯ ФОРМА, ФОРМАТ JSON
//
// Требует платформу 8.3.6 и выше. На 8.3.5 модуль не скомпилируется —
// там используйте вариант ОбычнаяФорма_XML.
//
// Собран автоматически из src/core.bsl + src/variant_ordinary_json.bsl.
// Правки вносить в src/, затем: python3 exporter-1c/build_modules.py
//
// Реквизиты формы, которые нужно создать:
//   РазмерЧанка    Число  (по умолчанию 500) — объектов на файл, 0 = без разбиения
//   ЛимитОбъектов  Число  (по умолчанию 0)   — объектов каждого вида, 0 = все
//
// Кнопка формы: обработчик нажатия -> ВыгрузитьСтруктуру
////////////////////////////////////////////////////////////////////////////////

Функция ФорматВыгрузки()
	Возврат "json";
КонецФункции

Процедура ВыгрузитьСтруктуру(Кнопка)

	Если РазмерЧанка < 0 Тогда
		Предупреждение("Размер чанка не может быть отрицательным.");
		Возврат;
	КонецЕсли;

	ДиалогСохранения = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогСохранения.Заголовок = "Сохранить выгрузку структуры конфигурации";
	ДиалогСохранения.ПолноеИмяФайла = ИмяФайлаАрхива();
	ДиалогСохранения.Фильтр = "ZIP-архив (*.zip)|*.zip";

	Если НЕ ДиалогСохранения.Выбрать() Тогда
		Возврат;
	КонецЕсли;

	ПутьНазначения = ДиалогСохранения.ПолноеИмяФайла;

	КаталогВыгрузки = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(КаталогВыгрузки);
	ВременныйАрхив = "";

	Попытка
		Итог = ВыгрузитьСтруктуруКонфигурации(
			КаталогВыгрузки, ФорматВыгрузки(), РазмерЧанка, ЛимитОбъектов);
		ВременныйАрхив = УпаковатьВыгрузкуВАрхив(КаталогВыгрузки);
		КопироватьФайл(ВременныйАрхив, ПутьНазначения);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		УдалитьФайлы(КаталогВыгрузки);
		Если ЗначениеЗаполнено(ВременныйАрхив) Тогда
			УдалитьФайлы(ВременныйАрхив);
		КонецЕсли;
		Предупреждение("Ошибка выгрузки: " + ТекстОшибки);
		Возврат;
	КонецПопытки;

	УдалитьФайлы(КаталогВыгрузки);
	УдалитьФайлы(ВременныйАрхив);

	Сообщение = "Выгружено объектов: " + Итог.ВсегоОбъектов
		+ ", файлов: " + Итог.Файлов + Символы.ПС
		+ "Архив: " + ПутьНазначения;

	Если Итог.Усечено Тогда
		Сообщение = Сообщение + Символы.ПС + Символы.ПС
			+ "ВНИМАНИЕ: выгрузка НЕПОЛНАЯ — задан лимит объектов."
			+ Символы.ПС + "Для рабочей загрузки установите ЛимитОбъектов = 0.";
	КонецЕсли;

	Предупреждение(Сообщение);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ЯДРО ВЫГРУЗКИ СТРУКТУРЫ КОНФИГУРАЦИИ
// schema_version = 1
//
// Формат-независимое ядро, общее для всех вариантов обработки.
// Директивы компиляции здесь не пишутся — их проставляет build_modules.py
// при сборке варианта под управляемую форму.
//
// Код, требующий платформу 8.3.6, размечен блоками условной сборки
// и вырезается сборщиком для вариантов под старые платформы.
//
// НЕ РЕДАКТИРОВАТЬ в exporter-1c/dist — править src/core.bsl и пересобрать.
////////////////////////////////////////////////////////////////////////////////

Функция ВерсияСхемы()
	Возврат "1";
КонецФункции

Функция ВерсияВыгрузчика()
	Возврат "2.0";
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Примитивы сериализации
////////////////////////////////////////////////////////////////////////////////

// Собственный разделитель пути: не зависит от наличия ПолучитьРазделительПути()
// в конкретной версии платформы и контексте выполнения.
Функция РазделительПути()
	ИнформацияОСистеме = Новый СистемнаяИнформация;
	ТипПлатформыСистемы = ИнформацияОСистеме.ТипПлатформы;
	Если ТипПлатформыСистемы = ТипПлатформы.Windows_x86
		ИЛИ ТипПлатформыСистемы = ТипПлатформы.Windows_x86_64 Тогда
		Возврат "\";
	Иначе
		Возврат "/";
	КонецЕсли;
КонецФункции

Функция ЭтоСкалярноеЗначение(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Возврат ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Булево")
		ИЛИ ТипЗначения = Тип("Дата");
КонецФункции

Функция СкалярВСтроку(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0; ЧН=0");
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
	Иначе
		Возврат Строка(Значение);
	КонецЕсли;
КонецФункции

// Универсальная запись Структуры в XML по конвенции schema v1:
//   скаляр           -> атрибут
//   массив структур  -> <ключ><item .../></ключ>
//   массив скаляров  -> <ключ><item value="..."/></ключ>
//   структура        -> <ключ .../>
// Пустые массивы не пишутся.
Процедура ЗаписатьСтруктуруВXML(Запись, ИмяЭлемента, Данные)
	Запись.ЗаписатьНачалоЭлемента(ИмяЭлемента);

	// Атрибуты обязаны быть записаны до любых вложенных элементов.
	Для Каждого КлючЗначение Из Данные Цикл
		Если ЭтоСкалярноеЗначение(КлючЗначение.Значение) Тогда
			Запись.ЗаписатьАтрибут(КлючЗначение.Ключ, СкалярВСтроку(КлючЗначение.Значение));
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючЗначение Из Данные Цикл
		Значение = КлючЗначение.Значение;
		ТипЗначения = ТипЗнч(Значение);

		Если ТипЗначения = Тип("Массив") Тогда
			Если Значение.Количество() = 0 Тогда
				// `files` обязателен даже у пустой конфигурации: без явного
				// `<files/>` loader не отличит ноль чанков от битого манифеста.
				Если ИмяЭлемента = "manifest" И КлючЗначение.Ключ = "files" Тогда
					Запись.ЗаписатьНачалоЭлемента("files");
					Запись.ЗаписатьКонецЭлемента();
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Запись.ЗаписатьНачалоЭлемента(КлючЗначение.Ключ);
			Для Каждого Элемент Из Значение Цикл
				Если ТипЗнч(Элемент) = Тип("Структура") Тогда
					ЗаписатьСтруктуруВXML(Запись, "item", Элемент);
				Иначе
					Запись.ЗаписатьНачалоЭлемента("item");
					Запись.ЗаписатьАтрибут("value", СкалярВСтроку(Элемент));
					Запись.ЗаписатьКонецЭлемента();
				КонецЕсли;
			КонецЦикла;
			Запись.ЗаписатьКонецЭлемента();

		ИначеЕсли ТипЗначения = Тип("Структура") Тогда
			ЗаписатьСтруктуруВXML(Запись, КлючЗначение.Ключ, Значение);
		КонецЕсли;
	КонецЦикла;

	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Обход метаданных
////////////////////////////////////////////////////////////////////////////////

Функция ПолноеИмяТипа(Тип)
	МетаданныеПоТипу = Метаданные.НайтиПоТипу(Тип);
	Если МетаданныеПоТипу = Неопределено Тогда
		Возврат СокрЛП(Строка(Тип));
	Иначе
		Возврат МетаданныеПоТипу.ПолноеИмя();
	КонецЕсли;
КонецФункции

// Дополняет Приемник полным списком типов и квалификаторами.
// Список типов НИКОГДА не усекается: схлопывание в "составной" — задача рендера.
Процедура ДополнитьОписаниемТипов(Приемник, ОписаниеТипов)
	Если ОписаниеТипов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	МассивТипов = Новый Массив;
	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		МассивТипов.Добавить(ПолноеИмяТипа(Тип));
	КонецЦикла;
	Если МассивТипов.Количество() > 0 Тогда
		Приемник.Вставить("type", МассивТипов);
	КонецЕсли;

	Попытка
		КвалификаторыСтроки = ОписаниеТипов.КвалификаторыСтроки;
		Если КвалификаторыСтроки <> Неопределено И КвалификаторыСтроки.Длина > 0 Тогда
			Приемник.Вставить("string_length", КвалификаторыСтроки.Длина);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		КвалификаторыЧисла = ОписаниеТипов.КвалификаторыЧисла;
		Если КвалификаторыЧисла <> Неопределено И КвалификаторыЧисла.Разрядность > 0 Тогда
			Приемник.Вставить("digits", КвалификаторыЧисла.Разрядность);
			Приемник.Вставить("fraction_digits", КвалификаторыЧисла.РазрядностьДробнойЧасти);
		КонецЕсли;
	Исключение
	КонецПопытки;

	// КвалификаторыДаты возвращаются всегда, даже когда типа Дата в наборе нет,
	// поэтому пишем их только при реальном наличии даты среди типов.
	Если МассивТипов.Найти("Дата") <> Неопределено Тогда
		Попытка
			КвалификаторыДаты = ОписаниеТипов.КвалификаторыДаты;
			Если КвалификаторыДаты <> Неопределено Тогда
				Приемник.Вставить("date_parts", Строка(КвалификаторыДаты.ЧастиДаты));
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Универсальная сборка коллекции полей: реквизиты, измерения, ресурсы,
// реквизиты табличных частей, признаки учёта.
Функция СобратьПоля(Коллекция)
	Результат = Новый Массив;
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Поле Из Коллекция Цикл
		ДанныеПоля = Новый Структура;
		ДанныеПоля.Вставить("name", Поле.Имя);
		ДанныеПоля.Вставить("synonym", Поле.Синоним);

		// Комментарий пишем, только если он несёт что-то сверх синонима.
		Попытка
			Если ЗначениеЗаполнено(Поле.Комментарий) И Поле.Комментарий <> Поле.Синоним Тогда
				ДанныеПоля.Вставить("comment", Поле.Комментарий);
			КонецЕсли;
		Исключение
		КонецПопытки;

		// Значимо только само наличие индексирования, "НеИндексировать" — шум.
		Попытка
			ЗначениеИндексирования = Строка(Поле.Индексирование);
			Если ЗначениеИндексирования <> "НеИндексировать" Тогда
				ДанныеПоля.Вставить("indexing", ЗначениеИндексирования);
			КонецЕсли;
		Исключение
		КонецПопытки;

		Попытка
			ДополнитьОписаниемТипов(ДанныеПоля, Поле.Тип);
		Исключение
		КонецПопытки;

		Результат.Добавить(ДанныеПоля);
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция СобратьТабличныеЧасти(Объект)
	Результат = Новый Массив;

	Попытка
		ТабличныеЧасти = Объект.ТабличныеЧасти;
	Исключение
		Возврат Результат;
	КонецПопытки;

	Для Каждого ТабЧасть Из ТабличныеЧасти Цикл
		ДанныеТЧ = Новый Структура;
		ДанныеТЧ.Вставить("name", ТабЧасть.Имя);
		ДанныеТЧ.Вставить("synonym", ТабЧасть.Синоним);
		ДанныеТЧ.Вставить("attributes", СобратьПоля(ТабЧасть.Реквизиты));
		Результат.Добавить(ДанныеТЧ);
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Массив полных имён метаданных: движения, владельцы, основания ввода.
Функция СписокПолныхИмен(Коллекция)
	Результат = Новый Массив;
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Коллекция Цикл
		Результат.Добавить(Элемент.ПолноеИмя());
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Предупреждения выгрузки: копятся без дублей, попадают в манифест.
// Тихая деградация недопустима — загрузчик должен видеть, чего не хватает.
Функция НовоеСостояниеВыгрузки()
	Состояние = Новый Структура;
	Состояние.Вставить("Предупреждения", Новый Массив);
	Состояние.Вставить("ПредопределенныеНедоступны", Ложь);
	Возврат Состояние;
КонецФункции

Процедура ДобавитьПредупреждение(Состояние, Текст, Детали = "")
	Если Состояние = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Предупреждения = Состояние.Предупреждения;
	Если Предупреждения.Количество() >= 20 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ЭлементПредупреждения Из Предупреждения Цикл
		Если ЭлементПредупреждения.text = Текст Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	НовоеПредупреждение = Новый Структура;
	НовоеПредупреждение.Вставить("text", Текст);
	Если ЗначениеЗаполнено(Детали) Тогда
		НовоеПредупреждение.Вставить("details", Детали);
	КонецЕсли;
	Предупреждения.Добавить(НовоеПредупреждение);
КонецПроцедуры

// Предопределённые бывают только у этих видов. У остальных обращение вызовет
// исключение и ложно пометит платформу как неподдерживающую.
Функция ВидПоддерживаетПредопределенные(ВидОбъекта)
	Возврат ВидОбъекта = "Справочник"
		ИЛИ ВидОбъекта = "ПланВидовХарактеристик"
		ИЛИ ВидОбъекта = "ПланСчетов"
		ИЛИ ВидОбъекта = "ПланВидовРасчета";
КонецФункции

// Основной путь: метод ОБЪЕКТА МЕТАДАННЫХ (не менеджера — у менеджера его нет).
Функция ПредопределенныеЧерезМетаданные(МетаОбъект)
	Возврат МетаОбъект.ПолучитьИменаПредопределенных();
КонецФункции

// Запасной путь: запрос к таблице объекта.
// Поле называется ИмяПредопределенныхДанных (проверено на 8.3.23).
Функция ПредопределенныеЧерезЗапрос(ПолноеИмяОбъекта)
	Имена = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ИмяПредопределенныхДанных КАК Имя
		|ИЗ " + ПолноеИмяОбъекта + "
		|ГДЕ Предопределенный = ИСТИНА";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Имя) Тогда
			Имена.Добавить(СокрЛП(Выборка.Имя));
		КонецЕсли;
	КонецЦикла;

	Возврат Имена;
КонецФункции

Функция СобратьПредопределенные(МетаОбъект, ВидОбъекта, Состояние)
	Результат = Новый Массив;
	Имена = Неопределено;

	Если НЕ ВидПоддерживаетПредопределенные(ВидОбъекта) Тогда
		Возврат Результат;
	КонецЕсли;

	// Платформа уже показала, что перечислить предопределённые не умеет —
	// не тратим время на заведомо провальные попытки по каждому объекту.
	Если Состояние <> Неопределено И Состояние.ПредопределенныеНедоступны Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Имена = ПредопределенныеЧерезМетаданные(МетаОбъект);
	Исключение
		ОшибкаМетаданных = ОписаниеОшибки();
		Попытка
			Имена = ПредопределенныеЧерезЗапрос(МетаОбъект.ПолноеИмя());
		Исключение
			Если Состояние <> Неопределено Тогда
				Состояние.ПредопределенныеНедоступны = Истина;
			КонецЕсли;
			ДобавитьПредупреждение(Состояние,
				"Платформа не поддерживает перечисление предопределённых элементов."
				+ " Секции predefined в выгрузке нет — источником должна стать"
				+ " выгрузка конфигурации в файлы.",
				"Метод объекта метаданных: " + ОшибкаМетаданных
				+ " | Запрос: " + ОписаниеОшибки());
			Возврат Результат;
		КонецПопытки;
	КонецПопытки;

	Если Имена = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Имя Из Имена Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("name", Имя);
		Результат.Добавить(Элемент);
	КонецЦикла;

	Возврат Результат;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Специфика по видам метаданных
////////////////////////////////////////////////////////////////////////////////

// Свойства объекта метаданных.
//
// Каждое свойство берётся своей попыткой, а не весь вид одной на всех.
// Общая попытка молча съедала остаток списка: `Объект.Периодичность` у
// регистра сведений не существует (свойство называется
// `ПериодичностьРегистраСведений`), исключение прерывало процедуру, и вместе
// с периодичностью терялся режим записи. Обнаружено 2026-08-17: у 2 615
// регистров сведений в пяти конфигурациях не было ни одного свойства, и
// выгрузка при этом считалась успешной.
//
Процедура ДополнитьСвойствамиВида(Данные, Объект, ВидОбъекта)
	Если ВидОбъекта = "Справочник" Тогда
		// Длина кода и наименования — не косметика: ноль означает, что поля
		// `Код` или `Наименование` у справочника нет вовсе.
		Попытка Данные.Вставить("hierarchical", Объект.Иерархический); Исключение КонецПопытки;
		Попытка Данные.Вставить("hierarchy_type", Строка(Объект.ВидИерархии)); Исключение КонецПопытки;
		Попытка Данные.Вставить("code_length", Объект.ДлинаКода); Исключение КонецПопытки;
		Попытка Данные.Вставить("description_length", Объект.ДлинаНаименования); Исключение КонецПопытки;
		Попытка Данные.Вставить("code_type", Строка(Объект.ТипКода)); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "Документ" Тогда
		Попытка Данные.Вставить("posting", Строка(Объект.Проведение)); Исключение КонецПопытки;
		Попытка Данные.Вставить("number_length", Объект.ДлинаНомера); Исключение КонецПопытки;
		Попытка Данные.Вставить("number_periodicity", Строка(Объект.ПериодичностьНомера)); Исключение КонецПопытки;
		Попытка Данные.Вставить("number_type", Строка(Объект.ТипНомера)); Исключение КонецПопытки;
		Попытка Данные.Вставить("numerator", ПолноеИмяИлиПусто(Объект.Нумератор)); Исключение КонецПопытки;
		Попытка Данные.Вставить("real_time_posting", Строка(Объект.ОперативноеПроведение)); Исключение КонецПопытки;
		Попытка Данные.Вставить("register_records_deletion", Строка(Объект.УдалениеДвижений)); Исключение КонецПопытки;
		// `ЗаписьДвиженийПриПроведении` — перечисление платформы, а не Булево.
		// Без `Строка()` его не принимает запись второго формата выгрузки:
		// «значение содержит данные недопустимых типов».
		Попытка Данные.Вставить("register_records_on_post", Строка(Объект.ЗаписьДвиженийПриПроведении)); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "РегистрСведений" Тогда
		// Имя свойства сверено со справкой платформы: у объекта метаданных
		// оно `ПериодичностьРегистраСведений`, а не `Периодичность`.
		// Значение `Непериодический` означает, что срезов у регистра нет.
		Попытка Данные.Вставить("periodicity", Строка(Объект.ПериодичностьРегистраСведений)); Исключение КонецПопытки;
		Попытка Данные.Вставить("write_mode", Строка(Объект.РежимЗаписи)); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "РегистрНакопления" Тогда
		Попытка Данные.Вставить("register_kind", Строка(Объект.ВидРегистра)); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "РегистрБухгалтерии" Тогда
		// `Корреспонденция` решает состав виртуальных таблиц: без неё нет ни
		// `ОстатокДт`/`ОстатокКт`, ни таблицы `ОборотыДтКт`. Без этого признака
		// сервер не может показать таблицы запроса регистра бухгалтерии вовсе.
		Попытка Данные.Вставить("correspondence", Объект.Корреспонденция); Исключение КонецПопытки;
		Попытка Данные.Вставить("chart_of_accounts", ПолноеИмяИлиПусто(Объект.ПланСчетов)); Исключение КонецПопытки;
		Попытка Данные.Вставить("period_adjustment_length", Объект.ДлинаУточненияПериода); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "РегистрРасчета" Тогда
		// Период действия и график определяют, есть ли `ФактическийПериодДействия`
		// и `ДанныеГрафика`, а базовый период — таблицы `База<Регистр>`.
		Попытка Данные.Вставить("action_period", Объект.ПериодДействия); Исключение КонецПопытки;
		Попытка Данные.Вставить("base_period", Объект.БазовыйПериод); Исключение КонецПопытки;
		Попытка Данные.Вставить("periodicity", Строка(Объект.Периодичность)); Исключение КонецПопытки;
		Попытка Данные.Вставить("chart_of_calculation_types", ПолноеИмяИлиПусто(Объект.ПланВидовРасчета)); Исключение КонецПопытки;
		Попытка Данные.Вставить("schedule", ПолноеИмяИлиПусто(Объект.График)); Исключение КонецПопытки;
		// `ДатаГрафика` и `ЗначениеГрафика` — не даты и не числа, а измерение и
		// ресурс графика: объекты метаданных. Нужны имена, `Строка()` от них
		// даёт представление вида «Измерение», по которому ничего не найти.
		Попытка Данные.Вставить("schedule_date", ИмяИлиПусто(Объект.ДатаГрафика)); Исключение КонецПопытки;
		Попытка Данные.Вставить("schedule_value", ИмяИлиПусто(Объект.ЗначениеГрафика)); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "ПланСчетов" Тогда
		// Виды субконто и их предельное число — то, без чего не написать запрос
		// к бухгалтерским итогам в разрезе аналитики.
		Попытка Данные.Вставить("ext_dimension_types", ПолноеИмяИлиПусто(Объект.ВидыСубконто)); Исключение КонецПопытки;
		Попытка Данные.Вставить("max_ext_dimension_count", Объект.МаксКоличествоСубконто); Исключение КонецПопытки;
		Попытка Данные.Вставить("code_mask", Строка(Объект.МаскаКода)); Исключение КонецПопытки;
		Попытка Данные.Вставить("code_length", Объект.ДлинаКода); Исключение КонецПопытки;
		Попытка Данные.Вставить("description_length", Объект.ДлинаНаименования); Исключение КонецПопытки;
		Попытка Данные.Вставить("accounting_flags", ИменаКоллекции(Объект.ПризнакиУчета)); Исключение КонецПопытки;
		Попытка Данные.Вставить("ext_dimension_accounting_flags", ИменаКоллекции(Объект.ПризнакиУчетаСубконто)); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "ПланВидовРасчета" Тогда
		Попытка Данные.Вставить("dependence_on_calculation_types", Строка(Объект.ЗависимостьОтВидовРасчета)); Исключение КонецПопытки;
		Попытка Данные.Вставить("action_period_use", Объект.ИспользованиеПериодаДействия); Исключение КонецПопытки;
		Попытка Данные.Вставить("base_calculation_types", СписокПолныхИмен(Объект.БазовыеВидыРасчета)); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "ПланВидовХарактеристик" Тогда
		// Тип значения характеристик — вложенной структурой `value_type`, как
		// у константы и определяемого типа.
		//
		// Класть его через `ДополнитьОписаниемТипов(Данные, ...)` нельзя:
		// процедура пишет ключ `type`, а он на уровне объекта уже занят видом
		// метаданных (`СобратьОбъект`). `Структура.Вставить` молча заменяет
		// значение, и вид объекта превращался в массив типов — загрузчик
		// получал `kind` списком и падал на построении индекса.
		ТипЗначения = Новый Структура;
		Попытка ДополнитьОписаниемТипов(ТипЗначения, Объект.Тип); Исключение КонецПопытки;
		Если ТипЗначения.Количество() > 0 Тогда
			Данные.Вставить("value_type", ТипЗначения);
		КонецЕсли;
		Попытка Данные.Вставить("characteristic_ext_values", ПолноеИмяИлиПусто(Объект.ДополнительныеЗначенияХарактеристик)); Исключение КонецПопытки;
		Попытка Данные.Вставить("hierarchical", Объект.Иерархический); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "Задача" Тогда
		// Адресация — отдельный регистр сведений; без неё непонятно, как
		// вообще искать задачи по исполнителю.
		Попытка Данные.Вставить("addressing", ПолноеИмяИлиПусто(Объект.Адресация)); Исключение КонецПопытки;
		Попытка Данные.Вставить("main_addressing_attribute", ИмяИлиПусто(Объект.ОсновнойРеквизитАдресации)); Исключение КонецПопытки;
		Попытка Данные.Вставить("current_performer", ИмяИлиПусто(Объект.ТекущийИсполнитель)); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "БизнесПроцесс" Тогда
		Попытка Данные.Вставить("task", ПолноеИмяИлиПусто(Объект.Задача)); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "ПланОбмена" Тогда
		Попытка Данные.Вставить("distributed_infobase", Объект.РаспределеннаяИнформационнаяБаза); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "ОбщийМодуль" Тогда
		Попытка Данные.Вставить("global", Объект.Глобальный); Исключение КонецПопытки;
		Попытка Данные.Вставить("server", Объект.Сервер); Исключение КонецПопытки;
		Попытка Данные.Вставить("client_managed", Объект.КлиентУправляемоеПриложение); Исключение КонецПопытки;
		Попытка Данные.Вставить("server_call", Объект.ВызовСервера); Исключение КонецПопытки;
		Попытка Данные.Вставить("privileged", Объект.Привилегированный); Исключение КонецПопытки;
		Попытка Данные.Вставить("external_connection", Объект.ВнешнееСоединение); Исключение КонецПопытки;
		Попытка Данные.Вставить("return_values_reuse", Строка(Объект.ПовторноеИспользованиеВозвращаемыхЗначений)); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "ПодпискаНаСобытие" Тогда
		Попытка Данные.Вставить("event", Строка(Объект.Событие)); Исключение КонецПопытки;
		Попытка Данные.Вставить("handler", Строка(Объект.Обработчик)); Исключение КонецПопытки;
		// Источник — список типов, которые эта подписка задевает. Ребро графа
		// в обратную сторону: «что сработает, если записать этот справочник».
		Попытка ДополнитьИсточникомПодписки(Данные, Объект.Источник); Исключение КонецПопытки;

	ИначеЕсли ВидОбъекта = "РегламентноеЗадание" Тогда
		Попытка Данные.Вставить("method", Строка(Объект.ИмяМетода)); Исключение КонецПопытки;
		Попытка Данные.Вставить("use", Объект.Использование); Исключение КонецПопытки;
		// Не `predefined`: этим ключом схема v1 называет список предопределённых
		// элементов справочника, и загрузчик его перебирает. Булево там роняло
		// загрузку — «'bool' object is not iterable».
		Попытка Данные.Вставить("is_predefined", Объект.Предопределенное); Исключение КонецПопытки;
		Попытка Данные.Вставить("key", Строка(Объект.Ключ)); Исключение КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Полное имя объекта метаданных или пустая строка, если свойство не заполнено.
// Пустая строка, а не Неопределено: оба формата выгрузки пишутся одинаково.
Функция ПолноеИмяИлиПусто(МетаОбъект)
	Если МетаОбъект = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат МетаОбъект.ПолноеИмя();
КонецФункции

// Короткое имя — для реквизитов внутри объекта, у которых полного имени нет.
Функция ИмяИлиПусто(МетаОбъект)
	Если МетаОбъект = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат МетаОбъект.Имя;
КонецФункции

Функция ИменаКоллекции(Коллекция)
	Результат = Новый Массив;
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Коллекция Цикл
		Результат.Добавить(Элемент.Имя);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Типы источников подписки на событие: `Справочник.Контрагенты`,
// `Документ.РеализацияТоваровУслуг`. Пишутся полными именами объектов, а не
// именами типов (`СправочникОбъект.Контрагенты`), — по ним строится ребро.
Процедура ДополнитьИсточникомПодписки(Данные, ОписаниеТипов)
	Если ОписаниеТипов = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Источники = Новый Массив;
	Для Каждого Тип Из ОписаниеТипов.Типы() Цикл
		ПолноеИмя = ПолноеИмяТипа(Тип);
		Если Источники.Найти(ПолноеИмя) = Неопределено Тогда
			Источники.Добавить(ПолноеИмя);
		КонецЕсли;
	КонецЦикла;

	Если Источники.Количество() > 0 Тогда
		Данные.Вставить("source", Источники);
	КонецЕсли;
КонецПроцедуры

Процедура ДополнитьСоставомВида(Данные, Объект, ВидОбъекта, Состояние)

	Если ВидОбъекта = "Справочник" Тогда
		Попытка
			Данные.Вставить("owners", СписокПолныхИмен(Объект.Владельцы));
		Исключение
		КонецПопытки;
		Данные.Вставить("attributes", СобратьПоля(Объект.Реквизиты));
		Данные.Вставить("tabular_parts", СобратьТабличныеЧасти(Объект));
		Данные.Вставить("predefined", СобратьПредопределенные(Объект, ВидОбъекта, Состояние));

	ИначеЕсли ВидОбъекта = "Документ" Тогда
		Данные.Вставить("attributes", СобратьПоля(Объект.Реквизиты));
		Данные.Вставить("tabular_parts", СобратьТабличныеЧасти(Объект));
		Попытка
			Данные.Вставить("movements", СписокПолныхИмен(Объект.Движения));
		Исключение
		КонецПопытки;
		Попытка
			Данные.Вставить("based_on", СписокПолныхИмен(Объект.ВводитсяНаОсновании));
		Исключение
		КонецПопытки;

	ИначеЕсли ВидОбъекта = "РегистрСведений"
		ИЛИ ВидОбъекта = "РегистрНакопления"
		ИЛИ ВидОбъекта = "РегистрБухгалтерии"
		ИЛИ ВидОбъекта = "РегистрРасчета" Тогда
		Попытка
			Данные.Вставить("dimensions", СобратьПоля(Объект.Измерения));
		Исключение
		КонецПопытки;
		Попытка
			Данные.Вставить("resources", СобратьПоля(Объект.Ресурсы));
		Исключение
		КонецПопытки;
		Попытка
			Данные.Вставить("attributes", СобратьПоля(Объект.Реквизиты));
		Исключение
		КонецПопытки;

	ИначеЕсли ВидОбъекта = "Константа" ИЛИ ВидОбъекта = "ОпределяемыйТип" Тогда
		ТипЗначения = Новый Структура;
		Попытка
			ДополнитьОписаниемТипов(ТипЗначения, Объект.Тип);
		Исключение
		КонецПопытки;
		Данные.Вставить("value_type", ТипЗначения);

	ИначеЕсли ВидОбъекта = "Перечисление" Тогда
		Значения = Новый Массив;
		Для Каждого ЗначениеПеречисления Из Объект.ЗначенияПеречисления Цикл
			ДанныеЗначения = Новый Структура;
			ДанныеЗначения.Вставить("name", ЗначениеПеречисления.Имя);
			ДанныеЗначения.Вставить("synonym", ЗначениеПеречисления.Синоним);
			Значения.Добавить(ДанныеЗначения);
		КонецЦикла;
		Данные.Вставить("enum_values", Значения);

	ИначеЕсли ВидОбъекта = "ПланВидовХарактеристик"
		ИЛИ ВидОбъекта = "ПланСчетов"
		ИЛИ ВидОбъекта = "ПланВидовРасчета"
		ИЛИ ВидОбъекта = "ПланОбмена"
		ИЛИ ВидОбъекта = "БизнесПроцесс"
		ИЛИ ВидОбъекта = "Задача" Тогда
		Попытка
			Данные.Вставить("attributes", СобратьПоля(Объект.Реквизиты));
		Исключение
		КонецПопытки;
		Данные.Вставить("tabular_parts", СобратьТабличныеЧасти(Объект));
		Данные.Вставить("predefined", СобратьПредопределенные(Объект, ВидОбъекта, Состояние));

	ИначеЕсли ВидОбъекта = "Отчет" ИЛИ ВидОбъекта = "Обработка" Тогда
		Попытка
			Данные.Вставить("attributes", СобратьПоля(Объект.Реквизиты));
		Исключение
		КонецПопытки;
		Данные.Вставить("tabular_parts", СобратьТабличныеЧасти(Объект));

	КонецЕсли;
КонецПроцедуры

// Единственная точка сборки объекта. Формат-независима.
Функция СобратьОбъект(Объект, ВидОбъекта, Состояние)
	Данные = Новый Структура;
	Данные.Вставить("full_name", Объект.ПолноеИмя());
	Данные.Вставить("type", ВидОбъекта);
	Данные.Вставить("name", Объект.Имя);
	Данные.Вставить("synonym", Объект.Синоним);

	Попытка
		Если ЗначениеЗаполнено(Объект.Комментарий) Тогда
			Данные.Вставить("comment", Объект.Комментарий);
		КонецЕсли;
	Исключение
	КонецПопытки;

	ДополнитьСвойствамиВида(Данные, Объект, ВидОбъекта);
	ДополнитьСоставомВида(Данные, Объект, ВидОбъекта, Состояние);

	Возврат Данные;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Реестр коллекций метаданных
// Добавить новый вид объектов = одна строка.
////////////////////////////////////////////////////////////////////////////////

Функция ДобавитьКоллекцию(Список, Коллекция, Вид, Код)
	Описание = Новый Структура;
	Описание.Вставить("Коллекция", Коллекция);
	Описание.Вставить("Вид", Вид);
	Описание.Вставить("Код", Код);
	Список.Добавить(Описание);
	Возврат Список;
КонецФункции

Функция КоллекцииМетаданных()
	Список = Новый Массив;

	ДобавитьКоллекцию(Список, Метаданные.Справочники,             "Справочник",             "catalog");
	ДобавитьКоллекцию(Список, Метаданные.Документы,               "Документ",               "document");
	ДобавитьКоллекцию(Список, Метаданные.РегистрыСведений,        "РегистрСведений",        "informationregister");
	ДобавитьКоллекцию(Список, Метаданные.РегистрыНакопления,      "РегистрНакопления",      "accumulationregister");
	ДобавитьКоллекцию(Список, Метаданные.Константы,               "Константа",              "constant");
	ДобавитьКоллекцию(Список, Метаданные.Перечисления,            "Перечисление",           "enum");
	ДобавитьКоллекцию(Список, Метаданные.ПланыВидовХарактеристик, "ПланВидовХарактеристик", "chartofcharacteristictypes");

	// Коллекции, которых может не быть в конкретной конфигурации/платформе.
	Попытка
		ДобавитьКоллекцию(Список, Метаданные.РегистрыБухгалтерии, "РегистрБухгалтерии", "accountingregister");
	Исключение
	КонецПопытки;
	Попытка
		ДобавитьКоллекцию(Список, Метаданные.РегистрыРасчета, "РегистрРасчета", "calculationregister");
	Исключение
	КонецПопытки;
	Попытка
		ДобавитьКоллекцию(Список, Метаданные.ПланыСчетов, "ПланСчетов", "chartofaccounts");
	Исключение
	КонецПопытки;
	Попытка
		ДобавитьКоллекцию(Список, Метаданные.ПланыВидовРасчета, "ПланВидовРасчета", "chartofcalculationtypes");
	Исключение
	КонецПопытки;
	Попытка
		ДобавитьКоллекцию(Список, Метаданные.ПланыОбмена, "ПланОбмена", "exchangeplan");
	Исключение
	КонецПопытки;
	Попытка
		ДобавитьКоллекцию(Список, Метаданные.БизнесПроцессы, "БизнесПроцесс", "businessprocess");
	Исключение
	КонецПопытки;
	Попытка
		ДобавитьКоллекцию(Список, Метаданные.Задачи, "Задача", "task");
	Исключение
	КонецПопытки;
	Попытка
		ДобавитьКоллекцию(Список, Метаданные.ОпределяемыеТипы, "ОпределяемыйТип", "definedtype");
	Исключение
	КонецПопытки;
	Попытка
		ДобавитьКоллекцию(Список, Метаданные.ОбщиеМодули, "ОбщийМодуль", "commonmodule");
	Исключение
	КонецПопытки;
	Попытка
		ДобавитьКоллекцию(Список, Метаданные.ПодпискиНаСобытия, "ПодпискаНаСобытие", "eventsubscription");
	Исключение
	КонецПопытки;
	Попытка
		ДобавитьКоллекцию(Список, Метаданные.РегламентныеЗадания, "РегламентноеЗадание", "scheduledjob");
	Исключение
	КонецПопытки;
	Попытка
		ДобавитьКоллекцию(Список, Метаданные.Отчеты, "Отчет", "report");
	Исключение
	КонецПопытки;
	Попытка
		ДобавитьКоллекцию(Список, Метаданные.Обработки, "Обработка", "dataprocessor");
	Исключение
	КонецПопытки;

	Возврат Список;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Запись чанков
//
// Контекст записи — Структура:
//   Формат      "xml" | "json"
//   Писатель    объект записи выбранного формата
//   Открыт      Булево
////////////////////////////////////////////////////////////////////////////////

Функция НовыйКонтекстЗаписи(ФорматФайлов)
	Контекст = Новый Структура;
	Контекст.Вставить("Формат", ФорматФайлов);
	Контекст.Вставить("Писатель", Неопределено);
	Контекст.Вставить("Открыт", Ложь);
	Возврат Контекст;
КонецФункции

Процедура ОткрытьЧанкXML(Контекст, ПутьФайла, ВидОбъекта, НомерЧанка, КоличествоОбъектов)
	Писатель = Новый ЗаписьXML;
	Писатель.ОткрытьФайл(ПутьФайла, "UTF-8");
	Писатель.ЗаписатьОбъявлениеXML();
	Писатель.ЗаписатьНачалоЭлемента("objects");
	Писатель.ЗаписатьАтрибут("schema_version", ВерсияСхемы());
	Писатель.ЗаписатьАтрибут("type", ВидОбъекта);
	Писатель.ЗаписатьАтрибут("chunk", Формат(НомерЧанка, "ЧГ=0"));
	Писатель.ЗаписатьАтрибут("count", Формат(КоличествоОбъектов, "ЧГ=0"));

	Контекст.Писатель = Писатель;
	Контекст.Открыт = Истина;
КонецПроцедуры

Процедура ОткрытьЧанкJSON(Контекст, ПутьФайла, ВидОбъекта, НомерЧанка, КоличествоОбъектов)
	Писатель = Новый ЗаписьJSON;
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	Писатель.ОткрытьФайл(ПутьФайла, "UTF-8", Ложь, ПараметрыJSON);
	Писатель.ЗаписатьНачалоОбъекта();
	Писатель.ЗаписатьИмяСвойства("schema_version");
	Писатель.ЗаписатьЗначение(ВерсияСхемы());
	Писатель.ЗаписатьИмяСвойства("type");
	Писатель.ЗаписатьЗначение(ВидОбъекта);
	Писатель.ЗаписатьИмяСвойства("chunk");
	Писатель.ЗаписатьЗначение(НомерЧанка);
	Писатель.ЗаписатьИмяСвойства("count");
	Писатель.ЗаписатьЗначение(КоличествоОбъектов);
	Писатель.ЗаписатьИмяСвойства("objects");
	Писатель.ЗаписатьНачалоМассива();

	Контекст.Писатель = Писатель;
	Контекст.Открыт = Истина;
КонецПроцедуры

Процедура ОткрытьЧанк(Контекст, ПутьФайла, ВидОбъекта, НомерЧанка, КоличествоОбъектов)
	Если Контекст.Формат = "json" Тогда
		ОткрытьЧанкJSON(Контекст, ПутьФайла, ВидОбъекта, НомерЧанка, КоличествоОбъектов);
		Возврат;
	КонецЕсли;
	ОткрытьЧанкXML(Контекст, ПутьФайла, ВидОбъекта, НомерЧанка, КоличествоОбъектов);
КонецПроцедуры

Процедура ЗаписатьОбъектВЧанк(Контекст, ДанныеОбъекта)
	Если Контекст.Формат = "json" Тогда
		ЗаписатьJSON(Контекст.Писатель, ПодготовитьКЗаписиJSON(ДанныеОбъекта));
		Возврат;
	КонецЕсли;
	ЗаписатьСтруктуруВXML(Контекст.Писатель, "object", ДанныеОбъекта);
КонецПроцедуры

// Приводит значения к тем типам, которые понимает `ЗаписатьJSON`.
//
// XML-ветка терпит что угодно: `ЗаписатьСтруктуруВXML` гонит каждое значение
// через `СкалярВСтроку`. У JSON такой прослойки не было, и одно свойство
// неожиданного типа роняло всю выгрузку целиком — «Значение содержит данные
// недопустимых типов», без указания, какое именно. Поймано 2026-08-17 на
// `ЗаписьДвиженийПриПроведении`: это перечисление платформы, а не Булево.
//
// Само свойство исправлено, но защита нужна отдельно: свойств у метаданных
// сотни, тип каждого наизусть не проверить, а падать целой выгрузкой из-за
// одного поля нельзя.
//
Функция ПодготовитьКЗаписиJSON(Значение)
	ТипЗначения = ТипЗнч(Значение);

	Если Значение = Неопределено ИЛИ ЭтоСкалярноеЗначение(Значение) Тогда
		Возврат Значение;

	ИначеЕсли ТипЗначения = Тип("Структура") Тогда
		Результат = Новый Структура;
		Для Каждого КлючЗначение Из Значение Цикл
			Результат.Вставить(КлючЗначение.Ключ, ПодготовитьКЗаписиJSON(КлючЗначение.Значение));
		КонецЦикла;
		Возврат Результат;

	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Результат = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Результат.Добавить(ПодготовитьКЗаписиJSON(Элемент));
		КонецЦикла;
		Возврат Результат;

	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
		Результат = Новый Соответствие;
		Для Каждого КлючЗначение Из Значение Цикл
			Результат.Вставить(Строка(КлючЗначение.Ключ), ПодготовитьКЗаписиJSON(КлючЗначение.Значение));
		КонецЦикла;
		Возврат Результат;

	КонецЕсли;

	// Перечисление платформы, объект метаданных, что угодно ещё — строкой.
	Возврат Строка(Значение);
КонецФункции

Процедура ЗакрытьЧанк(Контекст)
	Если НЕ Контекст.Открыт Тогда
		Возврат;
	КонецЕсли;

	Если Контекст.Формат = "json" Тогда
		Контекст.Писатель.ЗаписатьКонецМассива();
		Контекст.Писатель.ЗаписатьКонецОбъекта();
	Иначе
		Контекст.Писатель.ЗаписатьКонецЭлемента(); // objects
	КонецЕсли;

	Контекст.Писатель.Закрыть();
	Контекст.Писатель = Неопределено;
	Контекст.Открыт = Ложь;
КонецПроцедуры

Процедура ЗаписатьМанифестXML(ПутьФайла, ДанныеМанифеста)
	Писатель = Новый ЗаписьXML;
	Писатель.ОткрытьФайл(ПутьФайла, "UTF-8");
	Писатель.ЗаписатьОбъявлениеXML();
	ЗаписатьСтруктуруВXML(Писатель, "manifest", ДанныеМанифеста);
	Писатель.Закрыть();
КонецПроцедуры

Процедура ЗаписатьМанифестJSON(ПутьФайла, ДанныеМанифеста)
	Писатель = Новый ЗаписьJSON;
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);
	Писатель.ОткрытьФайл(ПутьФайла, "UTF-8", Ложь, ПараметрыJSON);
	ЗаписатьJSON(Писатель, ПодготовитьКЗаписиJSON(ДанныеМанифеста));
	Писатель.Закрыть();
КонецПроцедуры

Процедура ЗаписатьМанифест(ПутьФайла, ФорматФайлов, ДанныеМанифеста)
	Если ФорматФайлов = "json" Тогда
		ЗаписатьМанифестJSON(ПутьФайла, ДанныеМанифеста);
		Возврат;
	КонецЕсли;
	ЗаписатьМанифестXML(ПутьФайла, ДанныеМанифеста);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Главная процедура выгрузки
//
// КаталогВыгрузки  — существующий пустой каталог, куда лягут manifest и objects/
// ФорматФайлов     — "xml" | "json"
// РазмерЧанка      — объектов на файл, 0 = без разбиения
// ЛимитОбъектов    — объектов каждого вида, 0 = все (тестовый режим — иначе)
//
// Возвращает Структуру: ВсегоОбъектов, Файлов, Усечено.
////////////////////////////////////////////////////////////////////////////////

Функция ВыгрузитьСтруктуруКонфигурации(КаталогВыгрузки, ФорматФайлов, РазмерЧанка, ЛимитОбъектов)

	Разделитель = РазделительПути();
	КаталогОбъектов = КаталогВыгрузки + Разделитель + "objects";
	СоздатьКаталог(КаталогОбъектов);

	РазмерЧанкаФакт = ?(РазмерЧанка > 0, РазмерЧанка, 1000000);
	ФайлыМанифеста = Новый Массив;
	Состояние = НовоеСостояниеВыгрузки();
	ВсегоОбъектов = 0;
	Усечено = Ложь;

	Для Каждого Описание Из КоллекцииМетаданных() Цикл

		НомерЧанка = 0;
		ВЧанке = 0;
		Контекст = НовыйКонтекстЗаписи(ФорматФайлов);
		ОписаниеФайла = Неопределено;
		СчетчикВида = 0;

		Для Каждого Объект Из Описание.Коллекция Цикл

			Если ЛимитОбъектов > 0 И СчетчикВида >= ЛимитОбъектов Тогда
				Усечено = Истина;
				Прервать;
			КонецЕсли;

			Если НЕ Контекст.Открыт Тогда
				НомерЧанка = НомерЧанка + 1;
				ИмяФайла = Описание.Код + "."
					+ Формат(НомерЧанка, "ЧЦ=3; ЧВН=; ЧГ=0") + "." + ФорматФайлов;
				КоличествоОбъектов = Описание.Коллекция.Количество() - СчетчикВида;
				Если ЛимитОбъектов > 0
					И КоличествоОбъектов > ЛимитОбъектов - СчетчикВида Тогда
					КоличествоОбъектов = ЛимитОбъектов - СчетчикВида;
				КонецЕсли;
				Если КоличествоОбъектов > РазмерЧанкаФакт Тогда
					КоличествоОбъектов = РазмерЧанкаФакт;
				КонецЕсли;
				ОткрытьЧанк(Контекст,
					КаталогОбъектов + Разделитель + ИмяФайла,
					Описание.Вид,
					НомерЧанка,
					КоличествоОбъектов);
				ВЧанке = 0;

				ОписаниеФайла = Новый Структура;
				ОписаниеФайла.Вставить("path", "objects/" + ИмяФайла);
				ОписаниеФайла.Вставить("type", Описание.Вид);
				ОписаниеФайла.Вставить("count", 0);
				ФайлыМанифеста.Добавить(ОписаниеФайла);
			КонецЕсли;

			ЗаписатьОбъектВЧанк(Контекст, СобратьОбъект(Объект, Описание.Вид, Состояние));

			ВЧанке = ВЧанке + 1;
			СчетчикВида = СчетчикВида + 1;
			ВсегоОбъектов = ВсегоОбъектов + 1;
			ОписаниеФайла.count = ВЧанке;

			Если ВЧанке >= РазмерЧанкаФакт Тогда
				ЗакрытьЧанк(Контекст);
			КонецЕсли;
		КонецЦикла;

		ЗакрытьЧанк(Контекст);
	КонецЦикла;

	СистемнаяИнформацияСеанса = Новый СистемнаяИнформация;

	ДанныеМанифеста = Новый Структура;
	ДанныеМанифеста.Вставить("schema_version", ВерсияСхемы());
	ДанныеМанифеста.Вставить("format", ФорматФайлов);
	ДанныеМанифеста.Вставить("exporter_version", ВерсияВыгрузчика());
	ДанныеМанифеста.Вставить("name", Метаданные.Имя);
	ДанныеМанифеста.Вставить("synonym", Метаданные.Синоним);
	ДанныеМанифеста.Вставить("version", Метаданные.Версия);
	ДанныеМанифеста.Вставить("vendor", Метаданные.Поставщик);
	ДанныеМанифеста.Вставить("platform", СистемнаяИнформацияСеанса.ВерсияПриложения);
	ДанныеМанифеста.Вставить("exported_at", Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	ДанныеМанифеста.Вставить("objects_total", ВсегоОбъектов);
	ДанныеМанифеста.Вставить("chunk_size", РазмерЧанка);
	ДанныеМанифеста.Вставить("truncated", Усечено);
	// Признак для загрузчика: смог ли выгрузчик перечислить предопределённые.
	// Ложь -> источником предопределённых обязана стать выгрузка конфигурации
	// в файлы (платформы до 8.3.6 такой возможности не дают).
	ДанныеМанифеста.Вставить("predefined_available", НЕ Состояние.ПредопределенныеНедоступны);
	ДанныеМанифеста.Вставить("warnings", Состояние.Предупреждения);
	ДанныеМанифеста.Вставить("files", ФайлыМанифеста);

	ЗаписатьМанифест(
		КаталогВыгрузки + Разделитель + "manifest." + ФорматФайлов,
		ФорматФайлов,
		ДанныеМанифеста);

	Результат = Новый Структура;
	Результат.Вставить("ВсегоОбъектов", ВсегоОбъектов);
	Результат.Вставить("Файлов", ФайлыМанифеста.Количество());
	Результат.Вставить("Усечено", Усечено);
	Результат.Вставить("Предупреждений", Состояние.Предупреждения.Количество());
	Возврат Результат;
КонецФункции

// Упаковка каталога выгрузки в ZIP. Возвращает путь к созданному архиву.
Функция УпаковатьВыгрузкуВАрхив(КаталогВыгрузки)
	Разделитель = РазделительПути();
	ИмяАрхива = ПолучитьИмяВременногоФайла("zip");

	Архиватор = Новый ЗаписьZipФайла(ИмяАрхива);
	Архиватор.Добавить(
		КаталогВыгрузки + Разделитель + "*",
		РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
		РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
	Архиватор.Записать();

	Возврат ИмяАрхива;
КонецФункции

Функция ИмяФайлаАрхива()
	Возврат "СтруктураКонфигурации_" + Метаданные.Имя + "_"
		+ Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd") + ".zip";
КонецФункции

