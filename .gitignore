# --- Каталог данных ----------------------------------------------------------
# `data/` целиком вне git. Это том, который монтируется в контейнер: источники,
# разобранные индексы, кэш, реестр и локальный словарь. Переносится копированием
# каталога, а не через репозиторий.
#
# Содержимое либо проприетарное, либо производное:
#   hbk/          справка платформы — контент фирмы «1С», каждый берёт из своей
#                 поставки: /opt/1cv8/<версия>/shcntx_ru.hbk -> data/hbk/<версия>/
#   sources/      выгрузки структуры — метаданные конкретных внедрений
#   index/syntax/ разобранная справка: тот же контент «1С», только распакованный
#   index/cache/  кэш поисковых индексов — производное, восстанавливается само
#   dictionary.json, registry.json — состояние конкретной установки
data/

# Копии каталога данных под другими именами: переименовали `data/` ради
# проверки «с чистого листа» — и правило по имени каталога перестало
# защищать. Ровно так проприетарный индекс справки один раз уже попал в
# историю (см. AGENTS.md, «Данные»).
__data/
data.old/
data.bak/

# Производные от справки «1С» — где бы каталог данных ни лежал и как бы ни
# назывался. Контент тот же, просто распакованный: 24 331 описание и 1 502
# примера кода фирмы «1С».
**/index/syntax/
**/index/cache/

# Код конфигурации внедрения, код расширений к ней и входящие выгрузки — где
# бы каталог данных ни лежал и как бы ни назывался. Чувствительнее
# разобранной справки: это исходники конкретного клиента.
**/modules/
**/extensions/
**/incoming/
**/logs/

# Проприетарные форматы 1С — где бы ни лежали.
*.hbk
*.cf
*.epf
*.dt
СтруктураКонфигурации_*

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
# ...но собранные модули обработки — часть репозитория, их коммитим.
!exporter-1c/dist/
!exporter-1c/dist/**

# --- Node --------------------------------------------------------------------
node_modules/

# --- Секреты -----------------------------------------------------------------
# `ADMIN_TOKEN` и прочее окружение конкретной установки. Шаблоны с
# плейсхолдерами — наоборот, часть репозитория: по ним заводят свой `.env`.
.env
.env.*
!.env.example
!.env.template

# --- Служебное ---------------------------------------------------------------
.DS_Store
*.log
qdrant_storage/
_scratch/

# --- Локальная обвязка разработки --------------------------------------------
# Репозиторий публичный: наружу уходит сервер и обработка выгрузки. Всё, чем
# конкретный разработчик обкладывает свою рабочую копию, — его дело и в общую
# историю не идёт.

# Инструкции агентам. Живут у каждого свои, версионируются отдельно и наружу
# не выкладываются: это не документация проекта, а настройка инструмента.
/AGENTS.md
/CLAUDE.md
/GEMINI.md
/QWEN.md
/.cursorrules
/.clinerules
/.windsurfrules
/.aider.conf.yml
.cursor/
.aider*
.github/copilot-instructions.md

# Каталоги агентских рантаймов: скиллы, планы, локальные настройки, слепки
# сессий. Superpowers и всё, что он под собой создаёт, — сюда же.
.claude/
.opencode/
.codex/
.gemini/
.superpowers/
superpowers/
.agent/
.agents/

# Рабочие деревья git. `git worktree add` кладёт ветку каталогом рядом или
# внутрь рабочей копии — под любым из принятых имён она не должна попадать
# в коммит вместе с основной веткой.
.worktrees/
worktrees/
.git-worktrees/
/wt/
/wt-*/
/worktree-*/
*.worktree

# IDE и редакторы.
.idea/
.vscode/
*.swp
*~

# --- Документы ---------------------------------------------------------------
# По умолчанию `docs/` локальный: там доска задач, планы и рабочие разборы —
# они пишутся для нас и наружу не идут.
#
# Исключения — документы-контракты. Они описывают то, с чем человек снаружи
# обязан свериться: формат выгрузки, границу источников, устройство языка
# запросов и дашборда. README на них ссылается, значит они обязаны лежать
# в репозитории — иначе ссылка ведёт в 404.
#
# Правило добавления: документ публикуется, если на него ссылается README
# ИЛИ он описывает внешний контракт. Иначе остаётся локальным.
#
# Каталог гасится по `/docs/*`, а не `/docs/`: git не может вернуть файл,
# если исключён сам каталог, и строки-исключения ниже просто не сработали бы.
/docs/*
!/docs/schema-v1.md
!/docs/data-sources.md
!/docs/query-language-design.md
!/docs/dashboard-design.md
!/docs/modules-intake-design.md
!/docs/modules-provider-design.md
!/docs/standard-procedure-intents.md
