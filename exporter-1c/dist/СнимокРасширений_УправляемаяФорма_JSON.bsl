////////////////////////////////////////////////////////////////////////////////
// СНИМОК ФАКТИЧЕСКОЙ АКТИВНОСТИ РАСШИРЕНИЙ — УПРАВЛЯЕМАЯ ФОРМА, JSON
//
// Требует платформу 8.3.8 и выше: именно там метод
// РасширенияКонфигурации.Получить получил выбор источника (база данных,
// действующие и не применённые расширения текущего сеанса).
//
// Это отдельная внешняя обработка, а не команда обработки schema v1:
// статическая структура и runtime-состояние имеют разный жизненный цикл.
//
// Команда формы: ВыгрузитьСнимокРасширений
// Реквизиты формы не нужны.
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура ВыгрузитьСнимокРасширений(Команда)

	Результат = ПодготовитьСнимокРасширенийНаСервере();
	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		Возврат;
	КонецЕсли;

	ДиалогСохранения = Новый ДиалогВыбораФайла(
		РежимДиалогаВыбораФайла.Сохранение);
	ДиалогСохранения.Заголовок = "Сохранить снимок активности расширений";
	ДиалогСохранения.ПолноеИмяФайла = Результат.ИмяФайла;
	ДиалогСохранения.Фильтр = "JSON (*.json)|*.json";

	Если ДиалогСохранения.Выбрать() Тогда
		Попытка
			Данные = ПолучитьИзВременногоХранилища(Результат.Адрес);
			Данные.Записать(ДиалогСохранения.ПолноеИмяФайла);
			ПоказатьПредупреждение(
				, "Снимок сохранён: " + ДиалогСохранения.ПолноеИмяФайла);
		Исключение
			ПоказатьПредупреждение(
				, "Ошибка сохранения снимка: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	УдалитьИзВременногоХранилища(Результат.Адрес);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодготовитьСнимокРасширенийНаСервере()

	Результат = Новый Структура;
	Результат.Вставить("Ошибка", "");
	Результат.Вставить("Адрес", "");
	Результат.Вставить("ИмяФайла", "");
	ВременныйФайл = ПолучитьИмяВременногоФайла("json");

	Попытка
		ЗаписатьСнимокРасширенийJSON(ВременныйФайл);
		ДвоичныеДанныеСнимка = Новый ДвоичныеДанные(ВременныйФайл);
		Результат.Адрес = ПоместитьВоВременноеХранилище(
			ДвоичныеДанныеСнимка, Новый УникальныйИдентификатор());
		Результат.ИмяФайла = "СнимокРасширений_" + Метаданные.Имя + "_"
			+ Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd") + ".json";
	Исключение
		Результат.Ошибка = "Ошибка выгрузки снимка: " + ОписаниеОшибки();
	КонецПопытки;

	УдалитьФайлы(ВременныйФайл);
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеРасширенияДляСнимка(Расширение)

	Описание = Новый Структура;
	Описание.Вставить("uuid", НРег(Строка(Расширение.УникальныйИдентификатор)));
	Описание.Вставить("name", Расширение.Имя);
	Описание.Вставить("synonym", Расширение.Синоним);
	Описание.Вставить("version", Расширение.Версия);
	Описание.Вставить("enabled", Расширение.Активно);

	Назначение = "";
	Попытка
		Назначение = Строка(Расширение.Назначение);
	Исключение
	КонецПопытки;
	Описание.Вставить("purpose", Назначение);

	ОбластьДействия = "";
	Попытка
		ОбластьДействия = Строка(Расширение.ОбластьДействия);
	Исключение
	КонецПопытки;
	Описание.Вставить("scope", ОбластьДействия);

	Возврат Описание;

КонецФункции

&НаСервереБезКонтекста
Функция СписокРасширенийДляСнимка(Источник)

	Результат = Новый Массив;
	Для Каждого Расширение Из РасширенияКонфигурации.Получить(
		Неопределено, Источник) Цикл
		Результат.Добавить(ОписаниеРасширенияДляСнимка(Расширение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция РасширенияИзмененыПослеСтартаДляСнимка()

	// Метод появился только в 8.3.22, а три представления состава доступны
	// с 8.3.8. На младшей платформе Неопределено уйдёт в JSON как null:
	// неизвестность нельзя подменять значением Ложь.
	Результат = Неопределено;
	Попытка
		Результат = РасширенияКонфигурации.РасширенияКонфигурацииИзменены();
	Исключение
	КонецПопытки;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ДанныеСнимкаРасширений()

	СистемнаяИнформацияСеанса = Новый СистемнаяИнформация;
	Конфигурация = Новый Структура;
	Конфигурация.Вставить("name", Метаданные.Имя);
	Конфигурация.Вставить("version", Метаданные.Версия);
	Конфигурация.Вставить(
		"platform", СистемнаяИнформацияСеанса.ВерсияПриложения);

	Данные = Новый Структура;
	Данные.Вставить("format", "mcp1c-extension-runtime");
	Данные.Вставить("schema_version", 1);
	Данные.Вставить(
		"snapshot_id", НРег(Строка(Новый УникальныйИдентификатор())));
	Данные.Вставить(
		"captured_at",
		Формат(ТекущаяУниверсальнаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z");
	Данные.Вставить("scope", "current_session_current_data_area");
	Данные.Вставить("configuration", Конфигурация);
	Данные.Вставить(
		"database_changed_since_session_start",
		РасширенияИзмененыПослеСтартаДляСнимка());
	Данные.Вставить(
		"database",
		СписокРасширенийДляСнимка(
			ИсточникРасширенийКонфигурации.БазаДанных));
	Данные.Вставить(
		"session_active",
		СписокРасширенийДляСнимка(
			ИсточникРасширенийКонфигурации.СеансАктивные));
	Данные.Вставить(
		"session_disabled",
		СписокРасширенийДляСнимка(
			ИсточникРасширенийКонфигурации.СеансОтключенные));
	Возврат Данные;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьСнимокРасширенийJSON(ПутьФайла)

	Писатель = Новый ЗаписьJSON;
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(
		ПереносСтрокJSON.Авто, Символы.Таб);
	Писатель.ОткрытьФайл(ПутьФайла, "UTF-8", Ложь, ПараметрыJSON);
	ЗаписатьJSON(Писатель, ДанныеСнимкаРасширений());
	Писатель.Закрыть();

КонецПроцедуры
