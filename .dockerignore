# Контекст production-сборки закрыт по умолчанию. Даже новый локальный файл,
# забытый в .gitignore, не попадёт в BuildKit без явного разрешения здесь.
**

!requirements-lock.txt

!src/
src/*
!src/mcp1c/
src/mcp1c/*
!src/mcp1c/*.py
!src/mcp1c/dashboard_dist/
src/mcp1c/dashboard_dist/*
!src/mcp1c/dashboard_dist/index.html
!src/mcp1c/dashboard_dist/assets/
src/mcp1c/dashboard_dist/assets/*
!src/mcp1c/dashboard_dist/assets/*.css
!src/mcp1c/dashboard_dist/assets/*.js

!dashboard/
dashboard/*
!dashboard/package.json
!dashboard/package-lock.json
!dashboard/index.html
!dashboard/tsconfig.json
!dashboard/tsconfig.app.json
!dashboard/tsconfig.node.json
!dashboard/vite.config.ts
!dashboard/src/
dashboard/src/**
!dashboard/src/**/
!dashboard/src/**/*.ts
!dashboard/src/**/*.tsx
!dashboard/src/**/*.css
