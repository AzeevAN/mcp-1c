////////////////////////////////////////////////////////////////////////////////
// ПРОБНИК: как на этой платформе получить имена предопределённых элементов
//
// Одноразовая диагностика. Не часть выгрузки.
//
// Установка: новая внешняя обработка, управляемая форма, команда "Проверить".
// Результат печатается в служебные сообщения — скопировать целиком и прислать.
//
// Проверяет шесть способов на первом справочнике конфигурации, у которого
// предопределённые заведомо есть.
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура Проверить(Команда)
	ПроверитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаСервере()

	ИнформацияОСистеме = Новый СистемнаяИнформация;
	Сообщить("Платформа: " + ИнформацияОСистеме.ВерсияПриложения);
	Сообщить("Конфигурация: " + Метаданные.Имя + " " + Метаданные.Версия);
	Сообщить("");

	МетаСправочника = НайтиСправочникСПредопределенными();
	Если МетаСправочника = Неопределено Тогда
		Сообщить("Не нашёл справочник для проверки — в конфигурации нет справочников.");
		Возврат;
	КонецЕсли;

	ПолноеИмя = МетаСправочника.ПолноеИмя();
	Сообщить("Проверяю на: " + ПолноеИмя);
	Сообщить("--------------------------------------------------");

	// 1. Метод менеджера объекта
	Попытка
		Менеджер = Справочники[МетаСправочника.Имя];
		Имена = Менеджер.ПолучитьИменаПредопределенных();
		Сообщить("1. Менеджер.ПолучитьИменаПредопределенных() -> OK, "
			+ Имена.Количество() + " шт. " + ПримерыИмен(Имена));
	Исключение
		Сообщить("1. Менеджер.ПолучитьИменаПредопределенных() -> ОШИБКА: " + ОписаниеОшибки());
	КонецПопытки;

	// 2. Метод объекта метаданных
	Попытка
		Имена = МетаСправочника.ПолучитьИменаПредопределенных();
		Сообщить("2. ОбъектМетаданных.ПолучитьИменаПредопределенных() -> OK, "
			+ Имена.Количество() + " шт. " + ПримерыИмен(Имена));
	Исключение
		Сообщить("2. ОбъектМетаданных.ПолучитьИменаПредопределенных() -> ОШИБКА: " + ОписаниеОшибки());
	КонецПопытки;

	// 3. Запрос: ПредопределенноеИмяДанных
	ПроверитьЗапрос("3", "ПредопределенноеИмяДанных", ПолноеИмя);

	// 4. Запрос: ИмяПредопределенныхДанных
	ПроверитьЗапрос("4", "ИмяПредопределенныхДанных", ПолноеИмя);

	// 5. Запрос: только признак Предопределенный
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Всего ИЗ " + ПолноеИмя
			+ " ГДЕ Предопределенный = ИСТИНА";
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Сообщить("5. Запрос ГДЕ Предопределенный -> OK, предопределённых: " + Выборка.Всего);
	Исключение
		Сообщить("5. Запрос ГДЕ Предопределенный -> ОШИБКА: " + ОписаниеОшибки());
	КонецПопытки;

	// 6. Свойство объекта метаданных (если такое есть)
	Попытка
		Коллекция = МетаСправочника.ЭлементыПредопределенныхДанных;
		Сообщить("6. МетаОбъект.ЭлементыПредопределенныхДанных -> OK, "
			+ Коллекция.Количество() + " шт.");
	Исключение
		Сообщить("6. МетаОбъект.ЭлементыПредопределенныхДанных -> ОШИБКА: " + ОписаниеОшибки());
	КонецПопытки;

	Сообщить("--------------------------------------------------");
	Сообщить("Готово. Скопировать весь вывод целиком.");

КонецПроцедуры

&НаСервере
Функция НайтиСправочникСПредопределенными()
	// Валюты / ВидыНоменклатуры почти всегда имеют предопределённые.
	Для Каждого ИмяКандидата Из ИменаКандидатов() Цикл
		МетаОбъект = Метаданные.Справочники.Найти(ИмяКандидата);
		Если МетаОбъект <> Неопределено Тогда
			Возврат МетаОбъект;
		КонецЕсли;
	КонецЦикла;
	Для Каждого МетаОбъект Из Метаданные.Справочники Цикл
		Возврат МетаОбъект;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервереБезКонтекста
Функция ИменаКандидатов()
	Имена = Новый Массив;
	Имена.Добавить("ВидыНоменклатуры");
	Имена.Добавить("Валюты");
	Имена.Добавить("СтавкиНДС");
	Имена.Добавить("ВидыКонтактнойИнформации");
	Возврат Имена;
КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьЗапрос(Номер, ИмяПоля, ПолноеИмяТаблицы)
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 5 " + ИмяПоля + " КАК Имя ИЗ " + ПолноеИмяТаблицы;
		Выборка = Запрос.Выполнить().Выбрать();
		Значения = "";
		Пока Выборка.Следующий() Цикл
			Значения = Значения + " [" + Строка(Выборка.Имя) + "]";
		КонецЦикла;
		Сообщить(Номер + ". Запрос " + ИмяПоля + " -> OK." + Значения);
	Исключение
		Сообщить(Номер + ". Запрос " + ИмяПоля + " -> ОШИБКА: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПримерыИмен(Имена)
	Результат = "";
	Счетчик = 0;
	Для Каждого Имя Из Имена Цикл
		Если Счетчик >= 5 Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + " [" + Имя + "]";
		Счетчик = Счетчик + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции
